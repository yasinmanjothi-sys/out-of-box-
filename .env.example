# FTP Deployment Credentials for HostPinnacle cPanel
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to version control.

FTP_HOST=your-server.hostpinnacle.co.ke
FTP_USER=your_cpanel_username
FTP_PASS=your_cpanel_password
FTP_PORT=21

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GSC_VERIFICATION_CODE=your-gsc-verification-code

# GitHub Personal Access Token with write access to this repo.
# Not read from this file by the app - paste it into the /admin dashboard login screen instead.
GITHUB_TOKEN=your_github_personal_access_token

# Currently unused by the app - the /admin route authenticates via GITHUB_TOKEN, not this.
ADMIN_PASSWORD=your_admin_password
