# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Large product image folder - served via FTP to HostPinnacle, not via GitHub
# NOTE: must match the on-disk folder's exact case ("Website Products") - git's
# ignore matching is case-sensitive on Linux even though this worked "by accident"
# on case-insensitive filesystems (macOS/Windows) with the old lowercase pattern.
/public/Website Products/
deployment-pinnacle.zip
Out_Of_Box_Deploy_*.zip
Out_Of_Box_Fixed_Analytics_*.zip

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
